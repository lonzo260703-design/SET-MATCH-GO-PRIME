# Copia este archivo como .env y ajusta los valores
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Local (sin Postgres): se usa SQLite automáticamente si DATABASE_URL está vacío
# DATABASE_URL=postgresql://usuario:clave@host:5432/base

# IA
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Correo (obligatorio en producción para confirmar cuentas y recuperar contraseñas)
# Con Gmail: activa la verificación en 2 pasos y crea una "Contraseña de aplicación"
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=contraseña-de-aplicación-de-16-caracteres
# MAIL_DEFAULT_SENDER=tu_correo@gmail.com
